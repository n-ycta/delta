                  {
                    "value": "file",
                    "label": "Local files (quick start)"
                  },
                  {
                    "value": "postgres",
                    "label": "PostgreSQL + TimescaleDB"
                  }
                ]
              },
              {
                "key": "databaseUrl",
                "type": "secret",
                "label": "PostgreSQL connection URL",
                "help": "Stored privately on this node. Leave blank to retain the current connection."
