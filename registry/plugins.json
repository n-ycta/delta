      "id": "dev.delta.type",
      "component": "typing",
      "repository": "https://github.com/n-ycta/delta_type",
      "version": "0.3.0",
      "asset": "https://github.com/n-ycta/delta_type/releases/download/v0.3.0/delta_type.tar.gz",
