      "manifest": {
        "id": "dev.delta.type",
        "name": "Delta Type",
        "description": "Background Linux typing statistics with a separate optional trainer. Optional local physical-key history.",
        "publisher": "Delta",
        "version": "0.3.0",
        "contract": "^1.4.0",
        "icon": "keyboard",
        "category": "input",
        "runtime": {
          "targets": [
            "desktop",
            "vps",
            "container"
          ]
        },
        "capabilities": [
          "metrics.timeseries",
          "actions",
          "settings.live",
          "settings.read",
          "status.read"
        ],
        "settings": [
          {
            "key": "enabled",
            "type": "boolean",
            "default": true,
            "label": "Collect typing statistics"
          },
          {
            "key": "backgroundEnabled",
            "type": "boolean",
            "default": true,
            "label": "Background keyboard collection"
          },
          {
            "key": "language",
            "type": "select",
            "default": "unknown",
            "label": "Keyboard layout (manual)",
            "help": "evdev reports physical keys, not active layout or committed text. WPM and characters are estimates.",
            "options": [
              {
                "value": "unknown",
                "label": "Unknown"
              },
              {
                "value": "ru",
                "label": "Russian"
              },
              {
                "value": "en",
                "label": "English"
              }
            ]
          },
          {
            "key": "recordKeys",
            "type": "boolean",
            "default": false,
            "label": "Record physical key sequence locally",
            "help": "Optional. Never sent to metric storage. Text reconstruction is not supported by evdev.",
            "confirmation": {
              "id": "type.record-keys.v1",
              "title": "Enable key history?",
              "body": "History may include passwords, messages and other private input. Password fields cannot reliably be excluded. This stores physical key codes, not committed text.",
              "acceptLabel": "I understand; enable recording"
            }
          },
          {
            "key": "retentionDays",
            "type": "number",
            "default": 7,
            "min": 1,
            "max": 30,
            "step": 1,
            "unit": "days",
            "label": "Maximum key history lifetime",
            "help": "Private local history is removed at this age, or earlier at 10 MiB. You can clear it manually."
          }
        ],
        "actions": [
          {
            "id": "flush",
            "label": "Send accumulated aggregates"
          },
          {
            "id": "clear_history",
            "label": "Clear local key history",
            "dangerous": true
          }
        ],
        "metrics": [
          {
            "id": "wpm",
            "label": "Typing speed",
            "description": "Standard WPM: five characters per word.",
            "kind": "gauge",
            "unit": "wpm",
            "precision": 1,
            "better": "higher",
            "dimensions": [
              {
                "id": "language",
                "label": "Language",
                "values": [
                  {
                    "id": "ru",
                    "label": "Russian"
                  },
                  {
                    "id": "en",
                    "label": "English"
                  },
                  {
                    "id": "unknown",
                    "label": "Unknown"
                  }
                ]
              },
              {
                "id": "mode",
                "label": "Mode",
                "values": [
                  {
                    "id": "background",
                    "label": "Background typing"
                  },
                  {
                    "id": "trainer",
                    "label": "Trainer"
                  }
                ]
              }
            ],
            "aggregations": [
              "avg",
              "max",
              "min",
              "p95"
            ],
            "visualizations": [
              "timeseries",
              "comparison",
              "stat"
            ],
            "defaultFilters": {
              "mode": [
                "background"
              ]
            }
          },
          {
            "id": "accuracy",
            "label": "Without corrections",
            "description": "1 − corrections / entered characters. Not a spelling or text accuracy test.",
            "kind": "ratio",
            "unit": "ratio",
            "precision": 1,
            "better": "higher",
            "dimensions": [
