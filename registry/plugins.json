        "publisher": "Delta",
        "description": "Unified storage with local files or PostgreSQL + TimescaleDB.",
        "icon": "database",
        "category": "system",
        "runtime": {
          "targets": [
            "vps",
            "desktop",
            "container"
          ]
        },
        "metrics": [],
