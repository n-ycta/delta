        "localizations": {
          "en": {
            "name": "Delta Storage",
            "publisher": "Delta",
            "description": "Unified storage with local files or PostgreSQL + TimescaleDB.",
            "icon": "database",
            "category": "system",
            "metrics": [],
            "permissions": [
              {
                "scope": "register:storage",
                "reason": "Required runtime authority. This is executable plugin code, not a sandbox.",
                "optional": false
              },
              {
                "scope": "call:storage.*",
                "reason": "Required runtime authority. This is executable plugin code, not a sandbox.",
                "optional": false
              }
            ],
            "settings": [
              {
                "key": "engine",
                "type": "select",
                "label": "Storage engine",
                "default": "file",
                "options": [
                  {
                    "value": "file",
                    "label": "Local files (quick start)"
                  },
                  {
                    "value": "postgres",
                    "label": "PostgreSQL + TimescaleDB"
                  }
                ]
              },
              {
                "key": "databaseUrl",
                "type": "secret",
                "label": "PostgreSQL connection URL",
                "help": "Stored privately on this node. Leave blank to retain the current connection."
              },
              {
                "key": "confirmBackendChange",
                "type": "boolean",
                "label": "I understand that switching engines does not migrate existing data",
                "default": false
              }
            ]
          },
          "ru": {
            "name": "Delta Storage",
            "publisher": "Delta",
            "description": "Единое хранилище: локальные файлы или PostgreSQL + TimescaleDB.",
